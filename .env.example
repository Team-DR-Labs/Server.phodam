# cp .env.example .env 후 필요한 값만 수정한다.
# docker compose 와 로컬 실행(make run) 모두 이 파일을 사용한다.

APP_ENV=local
APP_PORT=8080
APP_EXPOSE_PORT=8080
APP_SHUTDOWN_TIMEOUT=10s
GIN_MODE=debug

DB_HOST=localhost
DB_PORT=5432
DB_EXPOSE_PORT=5432
DB_USER=phodam
DB_PASSWORD=phodam
DB_NAME=phodam
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
