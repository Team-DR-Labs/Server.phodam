# cp .env.example .env 후 필요한 값만 수정한다.
# docker compose 와 로컬 실행(make run) 모두 이 파일을 사용한다.

APP_ENV=local
APP_PORT=8080
APP_EXPOSE_PORT=8080
APP_SHUTDOWN_TIMEOUT=10s
GIN_MODE=debug

DB_HOST=localhost
DB_PORT=5432
DB_EXPOSE_PORT=5432
DB_USER=phodam
DB_PASSWORD=phodam
DB_NAME=phodam
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m

# 인증: JWT_SECRET 은 32바이트 이상. 운영에서는 반드시 별도 시크릿으로 교체한다.
JWT_SECRET=local-dev-jwt-secret-change-me-32bytes!!
# Apple aud = 번들 ID, Google aud = OAuth 클라이언트 ID (콤마 구분). 비어 있으면 해당 로그인은 거부된다.
APPLE_CLIENT_IDS=
GOOGLE_CLIENT_IDS=

# 오브젝트 스토리지 (로컬은 docker compose 의 MinIO)
# STORAGE_ENDPOINT 는 서버가 접근하는 주소, STORAGE_PUBLIC_ENDPOINT 는 presigned URL 서명에 쓰는 앱 접근 주소다.
# 서명에 호스트가 포함되므로 앱이 실제로 접속하는 호스트와 같아야 한다 (iOS 시뮬레이터: localhost:9000,
# Android 에뮬레이터: 10.0.2.2:9000, 실기기: PC 의 LAN IP:9000).
STORAGE_ENDPOINT=localhost:9000
STORAGE_PUBLIC_ENDPOINT=localhost:9000
STORAGE_EXPOSE_PORT=9000
STORAGE_CONSOLE_PORT=9001
STORAGE_ACCESS_KEY=phodam
STORAGE_SECRET_KEY=phodam-secret
STORAGE_USE_SSL=false
STORAGE_PUBLIC_USE_SSL=false
STORAGE_REGION=us-east-1
STORAGE_TEMP_BUCKET=phodam-temp
STORAGE_PERMANENT_BUCKET=phodam-permanent

# 관리자 API (X-Admin-Key). 비어 있으면 /v1/admin 라우트를 등록하지 않는다. make grant-film 에서도 사용.
ADMIN_API_KEY=local-admin-key

# 푸시: FCM 서비스 계정 JSON 경로. 비어 있으면 알림을 로그로만 출력한다.
FCM_CREDENTIALS_FILE=

# 주기 작업(만료·수령 기한·임박 알림·정리) 간격
WORKER_INTERVAL=1m
